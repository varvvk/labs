<Window x:Class="_4_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_4_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox Name="Celsius" HorizontalAlignment="Left" Margin="59,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="Celsius_TextChanged"/>
        <TextBox Name="Fahrenheit" HorizontalAlignment="Left" Margin="243,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="Fahrenheit_TextChanged"/>
        <Label Content="Цельсия" HorizontalAlignment="Left" Margin="59,60,0,0" VerticalAlignment="Top"/>
        <Label Content="Фаренгейт" HorizontalAlignment="Left" Margin="243,60,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
