<Window x:Class="_7_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_7_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Name="TextBlock" HorizontalAlignment="Left" Margin="93,111,0,0" TextWrapping="Wrap" Text="Text example" VerticalAlignment="Top" FontSize="20"/>
        <ComboBox Name="Background" HorizontalAlignment="Left" Margin="244,113,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="Background_SelectionChanged">
            <ComboBoxItem Content="Gray"/>
            <ComboBoxItem Content="Pink"/>
            <ComboBoxItem Content="Light Blue"/>
        </ComboBox>
        <ComboBox Name="Font" HorizontalAlignment="Left" Margin="400,113,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="Font_SelectionChanged">
            <ComboBoxItem Content="Arial"/>
            <ComboBoxItem Content="Times New Roman"/>
            <ComboBoxItem Content="Calibri"/>
        </ComboBox>
    </Grid>
</Window>
