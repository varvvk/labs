<Window x:Class="LR4_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR4_5"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Верхняя панель -->
            <RowDefinition Height="100"/>
            <!-- Панель поиска -->
            <RowDefinition Height="*"/>
            <!-- Основной контент -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" Background="#1F1F1F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Иконка -->
                <ColumnDefinition Width="*"/>
                <!-- Пустое пространство -->
                <ColumnDefinition Width="Auto"/>
                <!-- Кнопки -->
            </Grid.ColumnDefinitions>

            <Image Width="40" Height="40" Margin="10,9,10,0" VerticalAlignment="Top" Grid.Column="0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" Margin="10,0">
                <Button Content="Log In" Margin="7" Padding="5" Width="100" Background="White" VerticalAlignment="Center" Foreground="Black"/>
                <Button Content="RU" Margin="50,7,7,7" Padding="5" Width="50" Background="#97C2EC" VerticalAlignment="Center" Foreground="White"/>
                <Button Content="ENG" Margin="7" Padding="5" Width="50" Background="White" VerticalAlignment="Center" Foreground="Black"/>
            </StackPanel>
        </Grid>

        <!-- Панель поиска -->
        <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center" Grid.Row="1">
            <TextBox Width="400" Height="30" Margin="5" />
            <Button Content="Поиск" Width="80" Height="30" Margin="7" Padding="5" Background="#97C2EC" Foreground="White"/>
            <ComboBox Width="150" Height="30" Margin="5" Background="White">
                <ComboBoxItem Content="Sort by name"/>
                <ComboBoxItem Content="Sort by price"/>
            </ComboBox>
        </StackPanel>
        
        <!-- Основной контент -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <!-- Левая панель -->
                <ColumnDefinition Width="*"/>
                <!-- Правая панель -->
            </Grid.ColumnDefinitions>

            <!-- Категории -->
            <ListBox Grid.Column="0" Background="White" Margin="0,0,10,0" BorderThickness="0" SelectionMode="Single">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="20"/>
                        <Setter Property="Margin" Value="8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="#D6D0C2"/>
                        <!-- Цвет фона ВСЕГДА -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Наведение -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EBD8B7"/>
                                        </Trigger>
                                        <!-- Выделение -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#C7B299"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- Элементы -->
                <ListBoxItem Content="Показать все"/>
                <ListBoxItem Content="Косметология"/>
                <ListBoxItem Content="Дерматология"/>
                <ListBoxItem Content="Неврология"/>
                <ListBoxItem Content="Офтальмология"/>
            </ListBox>

            <!-- Карточки услуг -->
            <ScrollViewer Grid.Column="1">
                <WrapPanel HorizontalAlignment="Left">
                    <Border Background="White" Margin="5" Padding="10" Width="200" Height="120" CornerRadius="5" BorderBrush="#CCC" BorderThickness="1">
                        <TextBlock Text="Service 1" FontWeight="Bold"/>
                    </Border>
                    <Border Background="White" Margin="5" Padding="10" Width="200" Height="120" CornerRadius="5" BorderBrush="#CCC" BorderThickness="1">
                        <TextBlock Text="Service 2" FontWeight="Bold"/>
                    </Border>
                    <Border Background="White" Margin="5" Padding="10" Width="200" Height="120" CornerRadius="5" BorderBrush="#CCC" BorderThickness="1">
                        <TextBlock Text="Service 2" FontWeight="Bold"/>
                    </Border>
                    
                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
