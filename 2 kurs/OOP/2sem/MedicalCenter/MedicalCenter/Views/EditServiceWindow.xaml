<Window x:Class="MedicalCenter.Views.EditServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalCenter.Views"
        mc:Ignorable="d"
        Title="Редактирование сервиса" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Название" Margin="0,5,0,0"/>
            <TextBox Text="{Binding Title}" Margin="0,0,0,5"/>

            <TextBlock Text="Категория" Margin="0,5,0,0"/>
            <TextBox Text="{Binding Category}" Margin="0,0,0,5"/>

            <TextBlock Text="Описание" Margin="0,5,0,0"/>
            <TextBox Text="{Binding Description}" Margin="0,0,0,5"/>

            <TextBlock Text="Врач" Margin="0,5,0,0"/>
            <TextBox Text="{Binding Doctor}" Margin="0,0,0,5"/>

            <TextBlock Text="Цена" Margin="0,5,0,0"/>
            <TextBox Text="{Binding Price}" Margin="0,0,0,5"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Margin="5" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
