<Window x:Class="MedicalCenter.Views.AddServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalCenter.Views" xmlns:local1="clr-namespace:MedicalCenter.ViewModels"
        xmlns:command="clr-namespace:MedicalCenter.Commands"
        mc:Ignorable="d"
        Title="Добавить новую услугу" Height="380" Width="400">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Category Selection -->
        <TextBlock Text="Категория:" Grid.Row="0"/>
        <ComboBox x:Name="CategoryComboBox"
          Grid.Row="1" Margin="0,5,0,10"
          SelectedValue="{Binding Category, Mode=TwoWay}"
          SelectedValuePath="Content">
            <ComboBoxItem Content="Косметология"/>
            <ComboBoxItem Content="Дерматология"/>
            <ComboBoxItem Content="Неврология"/>
            <ComboBoxItem Content="Офтальмология"/>
        </ComboBox>


        <TextBox Grid.Row="3" Margin="0,5,0,10" Text="{Binding Title, Mode=TwoWay}"/>
        <TextBox Grid.Row="5" Margin="0,5,0,10" Text="{Binding Price, Mode=TwoWay}"/>
        <TextBox Grid.Row="7" Margin="0,5,0,10" Text="{Binding Description, Mode=TwoWay}"/>
        <TextBox Grid.Row="9" Margin="0,5,0,10" Text="{Binding Doctor, Mode=TwoWay}"/>


        <!-- Service Title -->
        <TextBlock Text="Название услуги:" Grid.Row="2"/>

        <!-- Price -->
        <TextBlock Text="Цена:" Grid.Row="4"/>

        <!-- Description -->
        <TextBlock Text="Описание:" Grid.Row="6"/>

        <!-- Doctor -->
        <TextBlock Text="Врач:" Grid.Row="8"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="10" HorizontalAlignment="Right">
            <Button Content="Очистить" Width="80" Margin="5" Background="#fca652" Foreground="White"
        Command="command:CustomCommands.ClearFields"/>

            <Button Content="Отмена" Width="80" Margin="5" Background="White" Command="{Binding CancelCommand}"/>
            <Button Content="Сохранить" Width="80" Margin="5" Background="#2dc28b" Foreground="White" Command="{Binding SaveCommand}"/>

        </StackPanel>
    </Grid>
</Window>
