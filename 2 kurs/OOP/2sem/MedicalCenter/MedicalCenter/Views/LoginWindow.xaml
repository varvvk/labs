<Window x:Class="MedicalCenter.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="280" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Label login/phone -->
            <RowDefinition Height="Auto" />
            <!-- TextBox login/phone -->
            <RowDefinition Height="Auto" />
            <!-- Label password -->
            <RowDefinition Height="Auto" />
            <!-- PasswordBox -->
            <RowDefinition Height="Auto" />
            <!-- User type & Button -->
        </Grid.RowDefinitions>

        <!-- Метка для логина/телефона -->
        <TextBlock Grid.Row="0" Text="{Binding UserNameLabel}" FontWeight="Bold" Margin="0,0,0,5" />

        <!-- Ввод логина/телефона -->
        <TextBox Grid.Row="1" Margin="0,0,0,10" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Метка для пароля -->
        <TextBlock Grid.Row="2" Text="Пароль" FontWeight="Bold" Margin="0,0,0,5" />

        <!-- Поле пароля -->
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Margin="0,0,0,15" />

        <!-- Выбор типа пользователя и кнопка Войти -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Text="Тип пользователя: " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Width="120"
          SelectedItem="{Binding SelectedUserType, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.ItemsSource>
                    <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                        <sys:String>Admin</sys:String>
                        <sys:String>Client</sys:String>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>
            <Button Content="Войти" Margin="20,0,0,0" Width="80" Command="{Binding LoginCommand}" />
        </StackPanel>
    </Grid>
</Window>
