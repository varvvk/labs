<Window x:Class="MedicalCenter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalCenter.Views"
        xmlns:controls="clr-namespace:MedicalCenter.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200">

    <Grid x:Name="MainGrid" Background="{DynamicResource MainWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource TopPanelBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock FontSize="14" FontWeight="Bold" Grid.Column="0" Margin="5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value=""/>
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                <Setter Property="Text" Value="Вы вошли как администратор"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="2" Margin="0,0,0,9">
                <Button Content="{DynamicResource Login}" Margin="7" Padding="5" Width="100" Background="White" VerticalAlignment="Center" Foreground="Black" Click="Button_Click"/>
                <Button Content="{DynamicResource Profile}" Margin="7" Padding="5" Width="100" Background="White" 
                        VerticalAlignment="Center" Foreground="Black" Click="ProfileButton_Click"/>
                <Button x:Name="RussianButton" Content="RU" Click="RussianButton_Click" Style="{DynamicResource ButtonStyle}" Margin="50,7,7,7" Padding="5" Width="50" VerticalAlignment="Center" Foreground="Black"/>
                <Button x:Name="EnglishButton" Content="ENG" Click="EnglishButton_Click" Margin="7" Padding="5" Width="50" Background="White" VerticalAlignment="Center" Foreground="Black"/>
                <Button Content="{DynamicResource Change_theme}"
                    Click="ChangeThemeButton_Click"
                    Width="100" Height="30"
                    Margin="40,7,7,7" Padding="5"
                    Background="{DynamicResource ThemeButtonColor}" Foreground="{DynamicResource ThemeButtonTextColor}"/> 

            </StackPanel>
        </Grid>

        <!-- Панель поиска -->
        <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center" Grid.Row="1">
            <controls:PatientAgeInput PreviewAgeSubmitted="PatientAgeInput_PreviewAgeSubmitted" AgeChecked="PatientAgeInput_AgeChecked"
                    AgeSubmitted="PatientAgeInput_AgeSubmitted" Margin="5" />
            <controls:SearchTextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox x:Name="SortComboBox"
                        Width="150" Height="30" Margin="5"
                        Background="White"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding SelectedSortOption, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="{DynamicResource SortByName}" Tag="Name" />
                <ComboBoxItem Content="{DynamicResource SortByPrice}" Tag="Price" />
            </ComboBox>
            <Button Content="{DynamicResource AddService}"
                    Command="{Binding OpenAddServiceWindow}"
                    Style="{StaticResource AddServiceButtonStyle}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Отменить" Click="UndoButton_Click" Width="100" Height="30" Margin="20,5,5, 5 " Background="White"/>
            <Button Content="Вернуть" Click="RedoButton_Click" Width="100" Height="30" Margin="5" Background="White"/>

        </StackPanel>

        <!-- Основной контент -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Категории -->
            <ListBox Grid.Column="0" x:Name="CategoryListBox" SelectedValuePath="Tag"
                    SelectedValue="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource MainWindowBackgroundBrush}" Margin="0,0,10,0" BorderThickness="0" SelectionMode="Single">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="8"/>
                        <Setter Property="Foreground" Value="{DynamicResource CategoryItemText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                        Background="{DynamicResource CategoryItemBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="17">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CategoryItemMouseOverBrush}"/>
                                        </Trigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CategoryItemSelectedBrush}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem Content="{DynamicResource ShowAll}" Tag="All"/>
                <ListBoxItem Content="{DynamicResource Cosmetology}" Tag="Косметология"/>
                <ListBoxItem Content="{DynamicResource Dermatology}" Tag="Дерматология"/>
                <ListBoxItem Content="{DynamicResource Neurology}" Tag="Неврология"/>
                <ListBoxItem Content="{DynamicResource Ophthalmology}" Tag="Офтальмология"/>
            </ListBox>

            <ScrollViewer Grid.Column="1">
                <ItemsControl ItemsSource="{Binding FilteredServices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="10" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" 
                                CornerRadius="10" Background="White" 
                                Margin="10" Padding="15" Width="250" Height="150"
                                MouseLeftButtonUp="ServiceCard_MouseLeftButtonUp" 
                                Cursor="Hand">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0} ₽'}" Grid.Row="1" Margin="0,10,0,0" FontSize="14"/>
                                    <TextBlock Text="{Binding Doctor, StringFormat='Врач: {0}'}" Grid.Row="2" Margin="0,10,0,0" FontSize="14"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
