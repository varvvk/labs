<UserControl x:Class="MedicalCenter.Controls.PatientAgeInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="50" Width="200">
    <StackPanel Orientation="Horizontal" Margin="5">
        <StackPanel Orientation="Horizontal">
            <Label Content="Возраст:" VerticalAlignment="Center"/>
            <TextBox Width="50" Height="30" Text="{Binding Age, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
            <Button Content="Ок" Click="OnSubmitClick" Margin="5,0,0,0" Height="30"/>
        </StackPanel>
        <TextBlock x:Name="OutputTextBlock" Margin="0,5,0,0" Foreground="DarkGreen" FontWeight="Bold"/>
    </StackPanel>
</UserControl>
