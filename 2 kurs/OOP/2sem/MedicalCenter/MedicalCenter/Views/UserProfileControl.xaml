<UserControl x:Class="MedicalCenter.Views.UserProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MedicalCenter.ViewModels"
             Height="Auto" Width="Auto">
    <Border BorderBrush="Gray" BorderThickness="1" Padding="20" Background="{DynamicResource MainWindowBackgroundBrush}">
        <StackPanel>
            <TextBlock Text="{DynamicResource Account}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="{DynamicResource Name}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Email"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="{DynamicResource Telephone}"/>
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Button Content="{DynamicResource Save}" Width="100" Height="30" 
                    Command="{Binding SaveCommand}" Background="#2dc28b" Foreground="White"/>

            <Button Content="{DynamicResource Close}"
            Width="100"
            Height="30"
            Margin="0,20,0,0"
            Background="#d9534f"
            Foreground="White"
            Command="{Binding CloseCommand}" />
        </StackPanel>
    </Border>
</UserControl>
