<Window x:Class="MedicalCenter.Views.ServiceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о сервисе" Height="400" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding Category}" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Price, StringFormat='Цена: {0} ₽'}"/>
            <TextBlock Text="{Binding Doctor, StringFormat='Врач: {0}'}"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Редактировать" Command="{Binding EditCommand}" Margin="5,0"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
