<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="MainWindowBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="#1F1F1F"/>
    <Style x:Key="ButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#7eafde"/>
    </Style>

    <SolidColorBrush x:Key="CategoryItemBackgroundBrush" Color="#7eafde"/>
    <SolidColorBrush x:Key="CategoryItemMouseOverBrush" Color="#8cc1f5"/>
    <SolidColorBrush x:Key="CategoryItemSelectedBrush" Color="#208efa"/>

    <SolidColorBrush x:Key="CategoryItemText" Color="White"/>

    <SolidColorBrush x:Key="ThemeButtonColor" Color="Pink"/>
    <SolidColorBrush x:Key="ThemeButtonTextColor" Color="Black"/>
</ResourceDictionary>
