<Window x:Class="MedicalCenter_ADO.PatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пациент" Height="200" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ФИО:"/>
            <TextBox x:Name="txtFullName" Width="350" Margin="0,5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="Дата рождения:"/>
            <DatePicker x:Name="dateBirth" Width="150"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="Сохранить" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
