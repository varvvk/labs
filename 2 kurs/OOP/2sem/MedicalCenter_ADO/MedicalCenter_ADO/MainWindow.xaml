<Window x:Class="MedicalCenter_ADO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalCenter_ADO"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl x:Name="MainTabControl">
            <TabItem Header="Patients">
                <Grid>
                    <WrapPanel Orientation="Horizontal" Margin="5">
                        <Button Content="Add" Click="AddPatient_Click" Margin="5"/>
                        <Button Content="Edit" Click="EditPatient_Click" Margin="5"/>
                        <Button Content="Delete" Click="DeletePatient_Click" Margin="5"/>
                        <TextBox x:Name="PatientSearchBox" Width="200" Margin="5"/>
                        <Button Content="Search Appointment" Click="SearchPatient_Click" Margin="5"/>
                    </WrapPanel>
                    <DataGrid x:Name="PatientsDataGrid" Margin="5,50,5,5" AutoGenerateColumns="True" IsReadOnly="True" CanUserSortColumns="True" />
                </Grid>
            </TabItem>
            <TabItem Header="Doctors">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135*"/>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="653*"/>
                    </Grid.ColumnDefinitions>
                    
                    <DataGrid x:Name="DoctorsDataGrid" Margin="5,5,5,5" AutoGenerateColumns="True" IsReadOnly="True" CanUserSortColumns="True" Grid.ColumnSpan="3" />
                </Grid>
            </TabItem>
            <TabItem Header="Appointments">
                <Grid>
                    <DataGrid x:Name="AppointmentsDataGrid" Margin="5" AutoGenerateColumns="True" IsReadOnly="True" CanUserSortColumns="True" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
