--- !u!114 &1464494173
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1464494165}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b7e4c1a92f3d84e6a9b5c2d1e0f8a7b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  statusPanel: {fileID: 1544526362}
  spawner: {fileID: 1176082738}
  statusTitle: {fileID: 631590517}
  statusText: {fileID: 560355362}
  introHint: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0432\u0441\u0435
    \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0432\u044B\u0437\u044B\u0432\u0430\u044F
    \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u0449\u0435\u043B\u0447\u043A\u043E\u043C
    \u043C\u044B\u0448\u0438 \u043F\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u043A\u043D\u043E\u043F\u043A\u0430\u043C \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438.\n\u041C\u0435\u043D\u044E
    - TAB"
  tasks:
  - title: "\u041E\u043F\u043B\u0430\u0442\u0430 \u043A\u0430\u0440\u0442\u043E\u0439"
    hint: "\u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440\u044B\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043E\u043F\u043B\u0430\u0442\u0430\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      Enter \u0434\u043B\u044F \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F
      \u043E\u043F\u043B\u0430\u0442\u044B"
    scenario: 0
  - title: "\u041D\u0430\u043B\u0438\u0447\u043D\u044B\u0435 \u0431\u0435\u0437 \u0441\u0434\u0430\u0447\u0438"
    hint: "\u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440\u044B\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043E\u043F\u043B\u0430\u0442\u0430\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      Enter \u0434\u043B\u044F \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F"
    scenario: 1
  - title: "\u041D\u0430\u043B\u0438\u0447\u043D\u044B\u0435 \u0441\u043E \u0441\u0434\u0430\u0447\u0435\u0439"
    hint: "\u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440\u044B, \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043E\u043F\u043B\u0430\u0442\u0430\nEnter \u0434\u043B\u044F \u0440\u0430\u0441\u0441\u0447\u0435\u0442\u0430
      \u0441\u0434\u0430\u0447\u0438\n\u0412\u044B\u0434\u0430\u0442\u044C \u0441\u0434\u0430\u0447\u0443
      (Q)\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435 Enter \u0434\u043B\u044F \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F"
    scenario: 2
  - title: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432"
    hint: "\u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440\u044B\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043E\u043F\u043B\u0430\u0442\u0430\n\u041D\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0442\u044C
      \u043A\u043B\u0438\u0435\u043D\u0442\u0430 (X)"
    scenario: 3
  - title: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0438 \u0434\u043E\u043F\u043B\u0430\u0442\u0430"
    hint: "\u041E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440\u044B, \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043E\u043F\u043B\u0430\u0442\u0430\n\u0417\u0430\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0443 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F \u0435\u0449\u0435
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430(M)\nEnter \u0434\u043B\u044F
      \u0440\u0430\u0441\u0441\u0447\u0435\u0442\u0430 \u0441\u0434\u0430\u0447\u0438\n\u0412\u044B\u0434\u0430\u0442\u044C
      \u0441\u0434\u0430\u0447\u0443 (Q), Enter \u0434\u043B\u044F \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F"
    scenario: 4
